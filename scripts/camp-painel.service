[Unit]
Description=CAMP Acervos — painel de administração
After=network.target

[Service]
User=campvision
WorkingDirectory=/home/campvision/camp-painel
EnvironmentFile=/home/campvision/camp-painel/backend/.env
ExecStart=/home/campvision/camp-painel/.venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
