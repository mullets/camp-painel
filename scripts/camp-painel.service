[Unit]
Description=CAMP Acervos — painel de administração
After=network.target

[Service]
User=camp
WorkingDirectory=/home/camp/camp-painel
EnvironmentFile=/home/camp/camp-painel/backend/.env
ExecStart=/home/camp/camp-painel/.venv/bin/uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
